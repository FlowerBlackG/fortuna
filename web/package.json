{
  "name": "fortuna-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev-all-hosts": "vp dev --host 0.0.0.0",
    "build": "tsc -b && vp build",
    "build:desktop": "tsc -b && vp build --mode desktop --outDir ../build/ui --emptyOutDir",
    "lint": "vp lint",
    "test": "vp test run",
    "test:browser": "node tests/e2e/smoke.mjs",
    "test:desktop-files": "node tests/e2e/desktop-files.mjs",
    "test:regression": "node tests/e2e/regression.mjs",
    "preview": "vp preview"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "axios": "^1.21.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "tdesign-icons-react": "^0.6.12",
    "tdesign-react": "^1.19.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  }
}
