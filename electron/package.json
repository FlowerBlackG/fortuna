{
  "name": "fortuna-desktop",
  "productName": "Fortuna",
  "version": "0.0.1",
  "description": "Fortuna personal asset settlement",
  "author": "Fortuna contributors",
  "license": "MulanPSL-2.0",
  "private": true,
  "type": "module",
  "main": "../build/electron/main.mjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "tsc -p tsconfig.json && node package.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  }
}
